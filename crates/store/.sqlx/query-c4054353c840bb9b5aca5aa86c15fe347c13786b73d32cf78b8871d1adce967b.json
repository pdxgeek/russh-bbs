  "query": "SELECT i.id, i.created_at, i.expires_at, i.redeemed_at,\n                      a.username AS \"redeemed_username?\"\n               FROM invite i LEFT JOIN accounts a ON a.id = i.redeemed_by\n               WHERE i.inviter_id = $1\n               ORDER BY i.id DESC\n               LIMIT $2",
