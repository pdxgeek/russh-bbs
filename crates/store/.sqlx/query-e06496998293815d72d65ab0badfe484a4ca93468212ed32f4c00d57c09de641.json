  "query": "SELECT f.id AS \"id!\", f.board_id AS \"board_id!\", b.name AS board_name, f.url,\n                      f.allow_http AS \"allow_http!\", f.interval_secs AS \"interval_secs!\",\n                      f.last_attempt_at, f.last_success_at, f.last_outcome,\n                      f.failures AS \"failures!\",\n                      EXISTS (SELECT 1 FROM board_public p WHERE p.board_id = f.board_id)\n                          AS \"public!\"\n               FROM feed f JOIN board b ON b.id = f.board_id WHERE f.board_id = $1",
